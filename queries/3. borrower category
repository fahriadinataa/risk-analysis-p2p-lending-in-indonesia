-- Analisis Kategori Peminjam per Periode Badan Usaha vs Perseorangan
SELECT
    Kategori,
    Periode,
    SUM(CASE WHEN Matriks = 'Total Outstanding Pinjaman' THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END) AS Total_Outstanding,
    SUM(CASE WHEN Matriks IN ('Pinjaman Macet  (> 90 hari)') THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END) AS Outstanding_Bermasalah,
    ROUND(SUM(CASE WHEN Matriks IN ('Pinjaman Macet  (> 90 hari)') THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END)
        / SUM(CASE WHEN Matriks = 'Total Outstanding Pinjaman' THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END)
    , 4) AS TWP90
FROM fact_loan_quality_category
GROUP BY Kategori, Periode
ORDER BY Periode
;

-- Growth Outstanding UMKM vs Non UMKM
SELECT 
	Kategori,
	Sub_Kategori,
    Periode,
   `Jumlah Rekening Penerima Pinjaman Aktif (entitas)` AS Jumlah_Rekening_Peminjam,
   `Outstanding Pinjaman (miliar Rp)` AS Oustanding_Pinjaman,
   ROUND((`Outstanding Pinjaman (miliar Rp)` - 
	LAG(`Outstanding Pinjaman (miliar Rp)`) OVER(PARTITION BY Kategori, Sub_Kategori ORDER BY Periode)) / 
	LAG(`Outstanding Pinjaman (miliar Rp)`) OVER(PARTITION BY Kategori, Sub_Kategori ORDER BY Periode), 3) AS Growth_Outstanding
FROM fact_loan_quality_category
WHERE Matriks = 'Total Outstanding Pinjaman'
ORDER BY Kategori, Sub_Kategori, Periode
;

-- Kesimpulan Kualitas Pinjaman Badan Usaha vs Perseorangan
WITH data_bulanan AS (
    SELECT 
		Kategori, 
        Periode, 
        SUM(CASE WHEN Matriks = 'Total Outstanding Pinjaman' THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END) AS Total_Outstanding, 
        SUM(CASE WHEN Matriks IN ('Pinjaman Macet  (> 90 hari)') THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END) AS Outstanding_Bermasalah
    FROM fact_loan_quality_category
    GROUP BY Kategori, Periode
),
growth AS (
    SELECT Kategori, Periode, Total_Outstanding,
        ROUND(Outstanding_Bermasalah / Total_Outstanding, 4) AS TWP90,
        ROUND(
            (Total_Outstanding - LAG(Total_Outstanding) OVER (PARTITION BY Kategori ORDER BY Periode))
            / LAG(Total_Outstanding) OVER (PARTITION BY Kategori ORDER BY Periode)
        , 3) AS Growth_Outstanding_MoM
    FROM data_bulanan
),
ringkasan AS (
    SELECT Kategori,
        ROUND(AVG(Growth_Outstanding_MoM), 3) AS Avg_Growth_Outstanding,
        ROUND(AVG(TWP90), 4) AS Avg_TWP90
    FROM growth
    GROUP BY Kategori
)
SELECT
    Kategori, Avg_Growth_Outstanding,
    ROUND(AVG(Avg_Growth_Outstanding) OVER (), 3) AS Threshold_Growth,
    Avg_TWP90,
    ROUND(AVG(Avg_TWP90) OVER (), 4) AS Threshold_TWP90,
    CASE
        WHEN Avg_Growth_Outstanding > AVG(Avg_Growth_Outstanding) OVER () AND Avg_TWP90 <= AVG(Avg_TWP90) OVER () THEN 'High Growth Low Risk'
        WHEN Avg_Growth_Outstanding > AVG(Avg_Growth_Outstanding) OVER () AND Avg_TWP90 > AVG(Avg_TWP90) OVER () THEN 'High Growth High Risk'
        WHEN Avg_Growth_Outstanding <= AVG(Avg_Growth_Outstanding) OVER () AND Avg_TWP90 > AVG(Avg_TWP90) OVER () THEN 'Low Growth High Risk'
        ELSE 'Low Growth Low Risk'
    END AS Kuadran
FROM ringkasan;
