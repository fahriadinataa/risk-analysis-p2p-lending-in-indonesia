-- Growth value loan disbursement per sektor
SELECT
	Sektor,
	Periode,
    Value,
    ROUND((Value - LAG(Value) OVER (PARTITION BY Sektor ORDER BY Periode)) /
		LAG(Value) OVER (PARTITION BY Sektor ORDER BY Periode), 2) AS Growth_MoM,
	ROUND((Value - LAG(Value, 12) OVER (PARTITION BY Sektor ORDER BY Periode)) /
		LAG(Value, 12) OVER (PARTITION BY Sektor ORDER BY Periode), 2) AS Growth_YoY
FROM fact_loan_disbursement_sec
;

-- Growth vs risk loan per lokasi
DROP TABLE IF EXISTS fact_growth_risk_loc;

CREATE TABLE fact_growth_risk_loc
SELECT 
	d.Provinsi,
    d.Periode,
    d.`Jumlah Penerima Pinjaman (akun)` AS Jumlah_Akun,
    ROUND((d.`Jumlah Penerima Pinjaman (akun)` - LAG(d.`Jumlah Penerima Pinjaman (akun)`) OVER(PARTITION BY d.Provinsi ORDER BY d.Periode)) /
		LAG(d.`Jumlah Penerima Pinjaman (akun)`) OVER(PARTITION BY d.Provinsi ORDER BY d.Periode), 3) AS Growth_Akun_MoM,
    d.`Jumlah Penyaluran Pinjaman (miliar Rp)` AS Jumlah_Pinjaman,
    ROUND((d.`Jumlah Penyaluran Pinjaman (miliar Rp)` - LAG(d.`Jumlah Penyaluran Pinjaman (miliar Rp)`) OVER(PARTITION BY d.Provinsi ORDER BY d.Periode)) /
		LAG(d.`Jumlah Penyaluran Pinjaman (miliar Rp)`) OVER(PARTITION BY d.Provinsi ORDER BY d.Periode), 3) AS Growth_Pinjaman_MoM,
	q.`twp 90` AS TWP90
FROM fact_loan_disbursement_loc d
JOIN fact_loan_quality_loc q ON d.Provinsi = q.Provinsi
	AND d.Periode = q.Periode
;
SELECT *
FROM growth_risk_loc
;
    
-- Growth vs Risk per lokasi peminjam
WITH ringkasan AS(
SELECT 
	Provinsi,
	ROUND(AVG(Growth_Pinjaman_MOM), 3) AS Avg_Growth_Pinjaman,
    ROUND(AVG(TWP90), 3) AS Avg_TWP90
FROM fact_growth_risk_loc
GROUP BY Provinsi
)
SELECT 
    Provinsi,
    Avg_Growth_Pinjaman,
    ROUND(AVG(Avg_Growth_Pinjaman) OVER (), 2) AS Threshold_Growth,
    Avg_TWP90,
    ROUND(AVG(Avg_TWP90) OVER (), 2) AS Threshold_TWP90,
    CASE
        WHEN avg_growth_pinjaman > AVG(avg_growth_pinjaman) OVER () 
             AND avg_TWP90 <= AVG(avg_TWP90) OVER () THEN 'High Growth Low Risk'
        WHEN avg_growth_pinjaman > AVG(avg_growth_pinjaman) OVER () 
             AND avg_TWP90 > AVG(avg_TWP90) OVER () THEN 'High Growth High Risk'
        WHEN avg_growth_pinjaman <= AVG(avg_growth_pinjaman) OVER () 
             AND avg_TWP90 > AVG(avg_TWP90) OVER () THEN 'Low Growth High Risk'
        ELSE 'Low Growth Low Risk'
    END AS Kuadran
FROM ringkasan
ORDER BY Kuadran, Avg_TWP90 DESC
;

-- Growth vs Risk per Kategori Peminjam (Badan Usaha vs Perseorangan)
WITH data_bulanan AS (
    SELECT
        Kategori,
        Periode,
        SUM(CASE WHEN Matriks = 'Total Outstanding Pinjaman' THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END) AS Total_Outstanding,
        SUM(CASE WHEN Matriks = 'Pinjaman Macet  (> 90 hari)' THEN `Outstanding Pinjaman (miliar Rp)` ELSE 0 END) AS Outstanding_Macet
    FROM fact_loan_quality_category
    GROUP BY Kategori, Periode
),
dengan_growth AS (
    SELECT
        Kategori,
        Periode,
        Total_Outstanding,
        ROUND(Outstanding_Macet / Total_Outstanding, 4) AS TWP90,
        ROUND(
            (Total_Outstanding - LAG(Total_Outstanding) OVER (PARTITION BY Kategori ORDER BY Periode))
            / LAG(Total_Outstanding) OVER (PARTITION BY Kategori ORDER BY Periode)
        , 3) AS Growth_Outstanding_MoM
    FROM data_bulanan
),
ringkasan AS (
    SELECT
        Kategori,
        ROUND(AVG(Growth_Outstanding_MoM), 3) AS Avg_Growth_Outstanding,
        ROUND(AVG(TWP90), 4) AS Avg_TWP90
    FROM dengan_growth
    GROUP BY Kategori
)
SELECT
    Kategori,
    Avg_Growth_Outstanding,
    ROUND(AVG(Avg_Growth_Outstanding) OVER (), 3) AS Threshold_Growth,
    Avg_TWP90,
    ROUND(AVG(Avg_TWP90) OVER (), 4) AS Threshold_TWP90,
    CASE
        WHEN Avg_Growth_Outstanding > AVG(Avg_Growth_Outstanding) OVER ()
             AND Avg_TWP90 <= AVG(Avg_TWP90) OVER () THEN 'High Growth Low Risk'
        WHEN Avg_Growth_Outstanding > AVG(Avg_Growth_Outstanding) OVER ()
             AND Avg_TWP90 > AVG(Avg_TWP90) OVER () THEN 'High Growth High Risk'
        WHEN Avg_Growth_Outstanding <= AVG(Avg_Growth_Outstanding) OVER ()
             AND Avg_TWP90 > AVG(Avg_TWP90) OVER () THEN 'Low Growth High Risk'
        ELSE 'Low Growth Low Risk'
    END AS Kuadran
FROM ringkasan
ORDER BY Kuadran, Avg_TWP90 DESC
;
